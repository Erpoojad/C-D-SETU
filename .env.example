# Postgres connection string. On Render, use the database's Internal Database URL.
DATABASE_URL="postgres://user:password@localhost:5432/setu"

# Signs login cookies. Any long random string; changing it signs everyone out.
SESSION_SECRET="replace-with-a-long-random-string"

# Code a municipal officer must enter to create an authority account.
# Share it only with verified ULB staff. Leave unset to disable authority sign-up.
AUTHORITY_INVITE_CODE=""

# Optional: enables the photo scanner. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
